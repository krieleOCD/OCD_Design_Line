{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/brand/**",
              "components/core/**",
              "components/forms/**",
              "ui_kits/company-deck-full/**",
              "ui_kits/company-deck/**",
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Arimo))/i]",
        "message": "Font not provided by the design system. Available: Arimo."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|orange|success|info|warning|danger)$/]",
        "message": "<Badge> tone must be one of 'neutral' | 'orange' | 'success' | 'info' | 'warning' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|full|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, full."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost|inverse)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost' | 'inverse'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:accent|dark|padded|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: accent, dark, padded."
      },
      {
        "selector": "JSXOpeningElement[name.name='Checkbox'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|key|ref|className|style|children)$/]",
        "message": "<Checkbox> doesn't accept that prop. Declared props: label."
      },
      {
        "selector": "JSXOpeningElement[name.name='HeadlineDuo'] > JSXAttribute > JSXIdentifier[name!=/^(?:lead|accent|size|leadColor|accentColor|as|key|ref|className|style|children)$/]",
        "message": "<HeadlineDuo> doesn't accept that prop. Declared props: lead, accent, size, leadColor, accentColor, as."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|hint|error|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: label, hint, error."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|tone|basePath|height|key|ref|className|style|children)$/]",
        "message": "<Logo> doesn't accept that prop. Declared props: variant, tone, basePath, height."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:master|small)$/]",
        "message": "<Logo> variant must be one of 'master' | 'small'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:dark|light|mono-dark|mono-light)$/]",
        "message": "<Logo> tone must be one of 'dark' | 'light' | 'mono-dark' | 'mono-light'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Overline'] > JSXAttribute > JSXIdentifier[name!=/^(?:color|key|ref|className|style|children)$/]",
        "message": "<Overline> doesn't accept that prop. Declared props: color."
      },
      {
        "selector": "JSXOpeningElement[name.name='Petal'] > JSXAttribute > JSXIdentifier[name!=/^(?:shape|corner|color|size|src|alt|key|ref|className|style|children)$/]",
        "message": "<Petal> doesn't accept that prop. Declared props: shape, corner, color, size, src, alt."
      },
      {
        "selector": "JSXOpeningElement[name.name='Petal'] > JSXAttribute[name.name='shape'] > Literal[value!=/^(?:quarter|half|circle|three-quarter)$/]",
        "message": "<Petal> shape must be one of 'quarter' | 'half' | 'circle' | 'three-quarter'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Petal'] > JSXAttribute[name.name='corner'] > Literal[value!=/^(?:tl|tr|bl|br)$/]",
        "message": "<Petal> corner must be one of 'tl' | 'tr' | 'bl' | 'br'."
      },
      {
        "selector": "JSXOpeningElement[name.name='RingMark'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|ring|core|thickness|key|ref|className|style|children)$/]",
        "message": "<RingMark> doesn't accept that prop. Declared props: size, ring, core, thickness."
      },
      {
        "selector": "JSXOpeningElement[name.name='Select'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|key|ref|className|style|children)$/]",
        "message": "<Select> doesn't accept that prop. Declared props: label."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute > JSXIdentifier[name!=/^(?:color|bg|key|ref|className|style|children)$/]",
        "message": "<Tag> doesn't accept that prop. Declared props: color, bg."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
